<svg xmlns="http://www.w3.org/2000/svg" class="pele-rs pele-rs-info" viewBox="0 0 113 40" width="113" height="40" style="max-width:100%;height:auto;--_bg:var(--pele-rs-bg,#fff);--_fg:var(--pele-rs-fg,#1f1f1f);--_m:var(--pele-rs-muted,#6e6e6e);--_l:var(--pele-rs-line,#1f1f1f);--_s:var(--pele-rs-surface,#f3f3f3);--_a:var(--pele-rs-surface-alt,#e6e6e6);--_b:var(--pele-rs-border,#8a8a8a);--_c:var(--pele-rs-accent,#5b7bd5);color:var(--_fg);--_fm:var(--pele-rs-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-rs-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="info" aria-labelledby="pele-rs-title" aria-describedby="pele-rs-desc"><title id="pele-rs-title">An information diagram</title><desc id="pele-rs-desc">It shows the version of the library.</desc><text class="pele-rs-version" fill="var(--_m)" x="56.5" y="25.6" text-anchor="middle">pele-rs v0.6.0</text></svg>
