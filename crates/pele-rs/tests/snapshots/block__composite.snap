<svg xmlns="http://www.w3.org/2000/svg" class="pele-rs pele-rs-block" viewBox="0 0 148 116" width="148" height="116" style="max-width:100%;height:auto;--_bg:var(--pele-rs-bg,#fff);--_fg:var(--pele-rs-fg,#1f1f1f);--_m:var(--pele-rs-muted,#6e6e6e);--_l:var(--pele-rs-line,#1f1f1f);--_s:var(--pele-rs-surface,#f3f3f3);--_a:var(--pele-rs-surface-alt,#e6e6e6);--_b:var(--pele-rs-border,#8a8a8a);--_c:var(--pele-rs-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-rs-radius,4px);--_fm:var(--pele-rs-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-rs-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="block"><g class="pele-rs-clusters"><g class="pele-rs-cluster" data-id="group"><rect x="8" y="8" width="132" height="100" fill="var(--_a)" fill-opacity="0.5" stroke="var(--_b)" style="rx:var(--_r)"/><text class="pele-rs-cluster-label" fill="var(--_m)" x="74" y="35.6" text-anchor="middle">A group</text></g></g><g class="pele-rs-nodes"><g class="pele-rs-node pele-rs-shape-rect" data-id="a" transform="translate(44,72)"><rect x="-24" y="-24" width="48" height="48" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text class="pele-rs-label" x="0" y="5.6" text-anchor="middle">a</text></g><g class="pele-rs-node pele-rs-shape-rect" data-id="b" transform="translate(104,72)"><rect x="-24" y="-24" width="48" height="48" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text class="pele-rs-label" x="0" y="5.6" text-anchor="middle">b</text></g></g></svg>
