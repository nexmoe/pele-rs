<svg xmlns="http://www.w3.org/2000/svg" class="pele pele-pie" viewBox="0 0 337 296" width="337" height="296" style="max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_tw:var(--pele-title-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="pie"><text class="pele-title" font-weight="var(--_tw)" text-anchor="middle" xml:space="preserve"><tspan x="168.5" y="25.6">Only one</tspan></text><g class="pele-slices" transform="translate(128,168)" stroke="var(--_bg)" stroke-width="1" stroke-linejoin="round"><path class="pele-slice" data-id="Only" d="M0,-120A120,120 0 1 1 0,120A120,120 0 1 1 0,-120Z" fill="var(--pele-series-1,#4c78a8)"/></g><g class="pele-slice-labels" transform="translate(128,168)" font-size="14" text-anchor="middle" fill="var(--_bg)"><text x="0" y="94.9">100%</text></g><g class="pele-legend" font-size="14"><g class="pele-legend-item" data-id="Only"><rect x="280" y="162" width="12" height="12" rx="2" fill="var(--pele-series-1,#4c78a8)"/><text x="314.39" y="172.9" text-anchor="middle">Only</text></g></g></svg>
