<svg xmlns="http://www.w3.org/2000/svg" class="pele pele-railroad" viewBox="0 0 150 144" width="150" height="144" style="max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_hw:var(--pele-heading-weight,bold);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="railroad"><g class="pele-rules" transform="translate(0.5,0.5)" font-size="14" text-anchor="middle"><g class="pele-rule" data-id="r"><text class="pele-rule-name" x="8" y="25.6" font-size="16" font-weight="var(--_hw)" text-anchor="start">r</text><path class="pele-edge pele-track" d="M16,53H28M122,53H134M28,53H48M102,53H122M28,53a10,10 0 0 1 10,10V111a10,10 0 0 0 10,10H58M92,121H102a10,10 0 0 0 10,-10V63a10,10 0 0 1 10,-10M48,53H58M92,53H102M58,53a10,10 0 0 0 -10,10V68a10,10 0 0 0 10,10H92a10,10 0 0 0 10,-10V63a10,10 0 0 0 -10,-10" fill="none" stroke="var(--_l)"/><path class="pele-marker" d="M71.5,78l7,-3.5v7z" fill="var(--_l)"/><circle class="pele-marker pele-start" cx="12" cy="53" r="4" fill="var(--_l)"/><circle class="pele-marker pele-end" cx="138" cy="53" r="4" fill="var(--_l)"/><text class="pele-edge-label pele-count" x="75" y="93" font-size="12" fill="var(--_m)">1–3×</text><g class="pele-node pele-terminal"><rect x="58" y="38" width="34" height="30" rx="15" fill="var(--_s)" stroke="var(--_b)"/><text x="75" y="57.9" font-family="var(--_fm)">a</text></g><g class="pele-node pele-terminal"><rect x="58" y="106" width="34" height="30" rx="15" fill="var(--_s)" stroke="var(--_b)"/><text x="75" y="125.9" font-family="var(--_fm)">b</text></g></g></g></svg>
